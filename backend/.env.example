# --- LLM Provider Keys ---
# Required: Your OpenAI API Key for agent brains
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database / Persistence ---
# Optional: Required later for LangGraph checkpointers (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/ara_db

# --- Logging Configuration ---
# Options: DEBUG, INFO, SUCCESS, WARNING, ERROR
LOG_LEVEL=INFO

# --- Environment Toggle ---
# Options: development, production
ENVIRONMENT=development
